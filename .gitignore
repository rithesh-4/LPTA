# Build output
build/

# LLVM installation (too large for git)
clang+llvm-*/
llvm.tar.xz

# Generated reports (output from running LPTA)
report*/
report_*/
test_report*/
test_for_change_feature/
demo_*/

# Generated assembly files
*.s
*.o
*.obj

# Temp batch scripts
run_llc_*.bat
*.run_llc.bat

# Local agent/tool state (large vendored deps live here)
.opencode/node_modules/
.opencode/*.log

# Generated IR snapshots
ir_before_opt.ll
ir_after_opt.ll

# Generated test outputs
tests/edge_cases/results/
tests/edge_cases/*.ll
!tests/edge_cases/ir/
tests/judge_demo/demo_output/
tests/judge_demo/output/
tests/correctness_report.txt
tests/test_report.txt
tests/fuzz_results.log
# Golden test evidence (regenerated each run)
tests/compare_golden/**/.cli.*
tests/compare_golden/**/.srv.*
tests/compare_golden/**/.ovr.*
tests/compare_golden/**/.norm.err
test_history_empty_tmp.json
test_output.txt

# Generated Doxygen output (sources in docs/ are tracked)
docs/doxygen/

# IDE / editor
.vscode/
.obsidian/
.idea/
*.swp
*.swo
*~

# Secrets (API keys live in the environment, never in files)
.env
*.key
.lpta_config.json

# Python artifacts
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
